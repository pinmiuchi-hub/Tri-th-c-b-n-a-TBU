# Supabase (đồng bộ chung dữ liệu WebGIS giữa các máy)
# Lấy ở: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL      : "Project URL" — dạng https://xxxx.supabase.co
#                       (code tự chấp nhận cả khi bạn dán kèm /rest/v1 hoặc /)
#   SUPABASE_ANON_KEY : khóa "anon public" (chuỗi eyJ...)
# GitHub Pages: đặt thành 2 repository secrets SUPABASE_URL / SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
